#!/bin/bash
# Add com.kelion.turnonlight.plist to ~/Library/LaunchAgents/ to run the script automatically
#
# <?xml version="1.0" encoding="UTF-8"?>
# <!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
# <plist version="1.0">
# <dict>
#     <key>Label</key>
#     <string>com.kelion.turnonlight</string>
#     <key>ProgramArguments</key>
#     <array>
#         <string>/Users/kelion/.dotfiles/bin/turn-on-light-when-camera-is-on</string>
#     </array>
#     <key>RunAtLoad</key>
#     <true/>
#     <key>KeepAlive</key>
#     <true/>
#     <key>StandardOutPath</key>
#     <string>/tmp/com.kelion.turnonlight.out</string>
#     <key>StandardErrorPath</key>
#     <string>/tmp/com.kelion.turnonlight.err</string>
# </dict>
# </plist>
#
# And run
# launchctl load ~/Library/LaunchAgents/com.kelion.turnonlight.plist

FLAG_FILE="/tmp/elgato_script_controlled"
LIGHT_URL="http://elgato-key-light-mini-2230.local:9123/elgato/lights"

# Function to get current light status
get_light_status() {
    local status
    status=$(curl -s -m 5 -X GET "$LIGHT_URL")
    echo "$status" | grep -o '"on":.*,' | cut -d':' -f2 | cut -d',' -f1
}

set_light() {
    curl -s -m 5 -X PUT "$LIGHT_URL" -H "Content-Type: application/json" -d "{\"lights\":[{\"on\":$1}]}"
    echo
}

is_display_connected() {
    system_profiler SPDisplaysDataType | grep -q "Odyssey G70B"
    return $?
}

camera_on=0
/usr/bin/log stream --predicate 'subsystem == "com.apple.controlcenter" && eventMessage CONTAINS "Active activity attributions changed"' |
  while read -r line; do
    case "$line" in
      *"Active activity attributions changed"*) ;;
      *) continue ;;
    esac
    case "$line" in
      *'"cam:'*) now_on=1 ;;
      *) now_on=0 ;;
    esac
    [ "$now_on" = "$camera_on" ] && continue
    camera_on=$now_on
    if [ "$camera_on" = 1 ]; then event="Start"; else event="Stop"; fi
    echo "$(date '+%F %T') Camera $event"
    if [ "$event" = "Start" ]; then
      current_status=$(get_light_status)
      if [ "$current_status" = "0" ] && is_display_connected; then
        echo "Lamp was off, turning on"
        set_light 1
        # Create flag file only if we actually turned on the light
        touch "$FLAG_FILE"
      fi
    else
      # Only turn off if the flag file exists (meaning the script turned it on)
      if [ -f "$FLAG_FILE" ]; then
        echo "Lamp off (was controlled by script)"
        set_light 0
        # Remove the flag file
        rm "$FLAG_FILE"
      else
        echo "Lamp state unchanged (was turned on manually)"
      fi
    fi
  done
