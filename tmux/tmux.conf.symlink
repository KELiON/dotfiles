# =============================================
# dmux recommended tmux config
# Theme: dark
# Generated by dmux onboarding
# =============================================

# --- Truecolor (Ghostty) ---
# tmux's own TERM must be tmux-256color; the RGB feature flag tells tmux
# that the outer terminal (Ghostty, TERM=xterm-ghostty) supports 24-bit color.
# Without this, Catppuccin Frappe gets approximated down to 256 colors.
set -g default-terminal "tmux-256color"
set -as terminal-features ",xterm-ghostty:RGB"

# Better support for Ctrl+Shift arrow bindings on newer tmux versions
set -gq extended-keys on
# Advertise extended keys to apps inside tmux (Shift+Enter, Ctrl+Shift+key)
set -as terminal-features ",xterm*:extkeys"

# --- Passthrough (agent-critical) ---
# Lets escape sequences pass through tmux to Ghostty: OSC 52 clipboard writes,
# desktop notifications from Claude Code, Kitty image protocol (yazi previews).
# `on` is the documented setting; dmux had `all` which is looser than needed.
set -g allow-passthrough on

# Keep TERM/TERM_PROGRAM fresh when reattaching so Ghostty integration works
set -ga update-environment "TERM"
set -ga update-environment "TERM_PROGRAM"

# --- Prefix ---
# Caps Lock stays Hyper (hold) / Esc (tap) — do NOT remap it to Ctrl.
# C-a is the classic prefix: easier than C-b, doesn't fight vim.
# Double-tap C-a sends a real C-a to the shell (beginning-of-line).
unbind C-b
set -g prefix C-a
bind C-a send-prefix

# --- Speed & sanity ---
# Zero escape-key delay: without this, vim/agent TUIs feel laggy (default 500ms)
set -s escape-time 0
# Windows numbered from 1, so prefix+1 is the first window (matches keyboard)
set -g base-index 1
setw -g pane-base-index 1
# Name windows after the pane's folder, not the process (`zsh` / `claude`).
setw -g automatic-rename on
setw -g automatic-rename-format '#{b:pane_current_path}'
# Renumber windows when one closes: no gaps in 1,2,3...
set -g renumber-windows on
# 100k lines of scrollback per pane (agent logs are long)
set -g history-limit 100000
# Report focus gain/loss to apps (vim autoread, agent idle detection)
set -g focus-events on
# BEL from any pane/window (Claude waiting for input) reaches Ghostty.
# `other` only rings for a different tmux window — splits in the same
# window would stay silent. `any` is what you want for prefix+a Claude.
set -g visual-bell off
set -g bell-action any
setw -g monitor-bell on
# Titlebar is hidden, but Mission Control / Cmd+Tab still show this.
# Session · window · command — so two Ghostty windows aren't both "ghostty".
set -g set-titles on
set -g set-titles-string '#S · #W · #{pane_current_command}'

# --- Session persistence (the whole point of tmux) ---
# Don't kill sessions when their last client detaches: close the Ghostty
# window, processes keep running, reattach later.
set -g destroy-unattached off
# When a session inside is destroyed, switch to another instead of detaching
set -g detach-on-destroy off

# Pane visuals (Catppuccin Frappe hexes — matches Ghostty theme)
set -g pane-border-format ' #[bold]#P #[default]#{?pane_title,#{pane_title},#{pane_current_command}} '
# Hide the pane header for a single-pane window; reveal it only when a split exists.
setw -g pane-border-status off
set-hook -g after-split-window 'if -F "#{>=:#{window_panes},2}" "set-window-option pane-border-status top" "set-window-option pane-border-status off"'
set-hook -g after-kill-pane 'if -F "#{>=:#{window_panes},2}" "set-window-option pane-border-status top" "set-window-option pane-border-status off"'
set-hook -g after-new-window 'set-window-option pane-border-status off'
# Don't dim inactive panes with a fake grey bg — it fights Ghostty's Frappe.
set -g window-style 'fg=default,bg=default'
set -g window-active-style 'fg=default,bg=default'
set -g pane-border-style 'fg=#626880,bg=default'
set -g pane-active-border-style 'fg=#ca9ee6,bg=default'
# sesh / lazygit popups: rounded corners + Frappe mauve (tmux 3.2+)
set -g popup-border-lines rounded
set -g popup-border-style 'fg=#ca9ee6'

# Status bar as a macOS-style tab strip (Frappe: text=#c6d0f5, base=#303446, mauve=#ca9ee6)
set -g status-position top
set -g status-style 'fg=#c6d0f5,bg=#303446'
set -g window-status-separator " "
setw -g window-status-style 'fg=#c6d0f5,bg=#303446'
setw -g window-status-current-style 'fg=#c6d0f5,bg=#303446'
setw -g window-status-format '#[fg=#414559,bg=#303446]#[fg=#c6d0f5,bg=#414559]#{E:@agent_icon}#[fg=#c6d0f5] #I #W #[fg=#414559,bg=#303446]'
setw -g window-status-current-format '#[fg=#ca9ee6,bg=#303446]#[fg=#303446,bg=#ca9ee6,bold]#{E:@agent_icon}#[fg=#303446] #I #W #[fg=#ca9ee6,bg=#303446]'
# Window that received a BEL (Claude waiting) lights up red until you visit it.
setw -g window-status-bell-style 'fg=#303446,bg=#e78284,bold'
# Keep the session name available to tmux pickers, but omit it from the visual tab strip.
set -g status-left ''
# PREFIX pill only while C-a is held. No cwd on the right — it duplicated the session name.
set -g status-right '#{?#(~/.dotfiles/bin/agent-tabs),,}#{?client_prefix,#[fg=#ca9ee6]#[fg=#303446,bg=#ca9ee6] PREFIX #[fg=#ca9ee6,bg=#303446],} '
set -g status-left-length 0
set -g status-right-length 40
set -g status-interval 1

# Fast pane navigation (no prefix — pairs with Hyper+Shift+arrows)
bind -n C-S-Left select-pane -L
bind -n C-S-Right select-pane -R
bind -n C-S-Up select-pane -U
bind -n C-S-Down select-pane -D

# --- Splits, vim-style panes, cwd inheritance ---
# New panes/windows start in the current pane's directory, not $HOME.
bind | split-window -h -c "#{pane_current_path}"
bind - split-window -v -c "#{pane_current_path}"
bind c new-window -c "#{pane_current_path}"
# Prefix + hjkl to move between panes (vim muscle memory)
bind h select-pane -L
bind j select-pane -D
bind k select-pane -U
bind l select-pane -R
# Default last-window is prefix+l — taken by pane-right. Tab toggles
# the previous tmux window (Claude in 1, shell in 2, back and forth).
bind Tab last-window
# Default last-pane is prefix+; (easy to miss). Space ping-pongs the
# Claude split from prefix+a without thinking about hjkl.
bind Space last-pane
# prefix+q overlay stays 2s (default 1s) so you can read pane numbers
# over a Claude split and type 1/2 before it vanishes.
set -g display-panes-time 2000
# Prefix + HJKL (repeatable) to resize
bind -r H resize-pane -L 5
bind -r J resize-pane -D 5
bind -r K resize-pane -U 5
bind -r L resize-pane -R 5
# Reload this file without restarting tmux
bind r source-file ~/.tmux.conf \; display-message "reloaded"
# prefix + C-k → clear screen and tmux scrollback (Cmd+K in Ghostty)
bind C-k send-keys -R \; send-keys C-l \; clear-history

# sesh picker: prefix + f → jump to any session / zoxide dir / configured project
# (K is already resize-pane -U; don't steal it)
bind-key f display-popup -h 90% -w 50% -E "sesh picker -i"
# prefix + s → last sesh session (rc ↔ rb). Replaces tmux's default
# choose-session; the picker already covers that.
bind s run-shell "sesh last || tmux display-message 'no last session'"

# prefix + a → vertical split in the current dir, launch Claude Code.
# Same flags as the `ai` alias, plus --name so the conversation matches
# the tmux session name.
# Resume later with: claude --resume <session-name>
# Pane closes when Claude exits.
bind a run-shell "tmux split-window -h -c #{q:pane_current_path} \"$HOME/.local/bin/claude --dangerously-skip-permissions --name #{q:session_name}\""
# prefix + e → equal-width columns. Space used to cycle layouts; we stole it
# for last-pane, so this is the one-shot "make the Claude split 50/50".
bind e select-layout even-horizontal
# prefix + b → promote this pane to its own window (default is prefix+!).
# After prefix+a, break Claude out when the split is too tight.
bind b break-pane
# prefix + B → join the last window back as a horizontal split (undo break).
bind B join-pane -h -s '!'
# prefix + g → lazygit overlay in the current pane's repo (review agent diffs).
bind g display-popup -d "#{pane_current_path}" -w 90% -h 90% -E "lazygit"

# Mouse + clipboard quality-of-life
set -g mouse on
set -g set-clipboard on
# vi keys in copy-mode (prefix+[): hjkl, v to select, y to yank.
setw -g mode-keys vi
# Copy-mode highlight: Frappe mauve, not default yellow.
setw -g mode-style 'fg=#292c3c,bg=#ca9ee6'
# prefix+/ hits: peach for other matches, red for the one n/N is on.
setw -g copy-mode-match-style 'fg=#292c3c,bg=#ef9f76'
setw -g copy-mode-current-match-style 'fg=#292c3c,bg=#e78284,bold'
bind -T copy-mode-vi v send-keys -X begin-selection
bind -T copy-mode-vi C-v send-keys -X rectangle-toggle
bind -T copy-mode-vi y send-keys -X copy-pipe-and-cancel 'pbcopy'
bind -T copy-mode-vi Escape send-keys -X cancel
# prefix+v → paste Mac clipboard (pairs with y yank). p stays previous-window.
bind v run-shell "pbpaste | tmux load-buffer - && tmux paste-buffer"
# prefix+/ → copy-mode + search (agent logs). n / N for next / prev.
bind / copy-mode \; send-keys /

# Copy selected text to system clipboard (best effort by platform)
if-shell "command -v pbcopy >/dev/null 2>&1" "bind-key -T copy-mode MouseDragEnd1Pane send-keys -X copy-pipe-and-cancel 'pbcopy'"
if-shell "command -v pbcopy >/dev/null 2>&1" "bind-key -T copy-mode-vi MouseDragEnd1Pane send-keys -X copy-pipe-and-cancel 'pbcopy'"
if-shell "command -v wl-copy >/dev/null 2>&1" "bind-key -T copy-mode MouseDragEnd1Pane send-keys -X copy-pipe-and-cancel 'wl-copy'"
if-shell "command -v wl-copy >/dev/null 2>&1" "bind-key -T copy-mode-vi MouseDragEnd1Pane send-keys -X copy-pipe-and-cancel 'wl-copy'"
if-shell "command -v xclip >/dev/null 2>&1" "bind-key -T copy-mode MouseDragEnd1Pane send-keys -X copy-pipe-and-cancel 'xclip -selection clipboard -in'"
if-shell "command -v xclip >/dev/null 2>&1" "bind-key -T copy-mode-vi MouseDragEnd1Pane send-keys -X copy-pipe-and-cancel 'xclip -selection clipboard -in'"

# Clipboard and cursor compatibility
set -ga terminal-overrides ',xterm-256color:Ms=\E]52;c;%p2%s\007'
set -ga terminal-overrides ',*:Ss=\E[%p1%d q:Se=\E[2 q'

# Preserve terminal program info inside tmux
set -ga update-environment "TERM_PROGRAM"

# --- TPM (plugin manager) ---
# prefix + I  install plugins
# prefix + U  update plugins
# prefix + alt+u  uninstall unused
set -g @plugin 'tmux-plugins/tpm'
set -g @plugin 'tmux-plugins/tmux-resurrect'
set -g @plugin 'tmux-plugins/tmux-continuum'
set -g @resurrect-capture-pane-contents 'on'
set -g @continuum-restore 'on'
set -g @continuum-save-interval '15'
# MUST be last
run '~/.tmux/plugins/tpm/tpm'
